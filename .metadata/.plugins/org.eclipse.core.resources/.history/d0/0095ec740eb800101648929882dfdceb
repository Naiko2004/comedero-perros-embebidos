#include "HX711.h"
#include "stm32f1xx_hal.h"
#include <string.h>

/* Internal state machine details */
typedef enum {
    S_IDLE = 0,
    S_WAIT_READY,
    S_BIT_RISE,     /* we will set SCK high, then wait pulse_high_us, then read bit and set low */
    S_BIT_FALL,     /* waiting for low phase to finish before next pulse */
    S_POST_PULSES,  /* extra pulses for gain selection */
    S_SAMPLE_DONE,
    S_TIMEOUT
} state_e;



static inline uint32_t now_us(TIM_HandleTypeDef *htim) {
    return (uint32_t)__HAL_TIM_GET_COUNTER(htim);
}

/* small wrappers for GPIO to make code shorter */
static inline void sck_high(hx711_t *d) { HAL_GPIO_WritePin(d->sck_port, d->sck_pin, GPIO_PIN_SET); }
static inline void sck_low(hx711_t *d)  { HAL_GPIO_WritePin(d->sck_port, d->sck_pin, GPIO_PIN_RESET); }
static inline GPIO_PinState dt_state(hx711_t *d) { return HAL_GPIO_ReadPin(d->dt_port, d->dt_pin); }

/* default timings (microseconds). The TIM must be 1MHz */
#define PULSE_HIGH_US  1u
#define PULSE_LOW_US   1u
#define WAIT_READY_TIMEOUT_MS 200u

/* Construction */
void HX711_Construct(hx711_t *dev,
                     GPIO_TypeDef *dt_port, uint16_t dt_pin,
                     GPIO_TypeDef *sck_port, uint16_t sck_pin,
                     TIM_HandleTypeDef *htim_us,
                     int32_t fixed_point_scale)
{
    /* zero memory then copy known fields */
    memset(dev, 0, sizeof(hx711_t));
    dev->dt_port = dt_port;
    dev->dt_pin  = dt_pin;
    dev->sck_port = sck_port;
    dev->sck_pin  = sck_pin;
    dev->htim_us = htim_us;
    dev->FP = fixed_point_scale > 0 ? fixed_point_scale : 1000;
    dev->extra_pulses = 1; /* keep same as original code */
    dev->known_counts_per_mg = 1; /* prevent div-by-zero until calibrated */
    dev->state = S_IDLE;
    dev->busy = 0;
}

/* init pins like your original */
void HX711_InitPins(hx711_t *dev)
{
    sck_high(dev);
    HAL_Delay(10);
    sck_low(dev);
    HAL_Delay(10);
}

/* Blocking single read (compat) */
int32_t HX711_ReadBlocking(hx711_t *dev)
{
    uint32_t data = 0;
    uint32_t start = HAL_GetTick();
    /* wait DT low */
    while (dt_state(dev) == GPIO_PIN_SET) {
        if ((HAL_GetTick() - start) > WAIT_READY_TIMEOUT_MS) return 0;
    }
    for (int8_t i = 0; i < 24; ++i) {
        sck_high(dev);
        /* busy-wait micro delay using TIM counter */
        uint32_t t0 = now_us(dev->htim_us);
        while ((uint32_t)(now_us(dev->htim_us) - t0) < PULSE_HIGH_US);
        /* read bit */
        data = (data << 1) | (dt_state(dev) == GPIO_PIN_SET ? 1u : 0u);
        sck_low(dev);
        t0 = now_us(dev->htim_us);
        while ((uint32_t)(now_us(dev->htim_us) - t0) < PULSE_LOW_US);
    }
    /* extra pulse for gain */
    sck_high(dev);
    uint32_t t0 = now_us(dev->htim_us);
    while ((uint32_t)(now_us(dev->htim_us) - t0) < PULSE_HIGH_US);
    sck_low(dev);
    t0 = now_us(dev->htim_us);
    while ((uint32_t)(now_us(dev->htim_us) - t0) < PULSE_LOW_US);

    if (data & 0x800000) data |= 0xFF000000u;
    return (int32_t)data;
}

int32_t HX711_GetAverageBlocking(hx711_t *dev, uint8_t samples)
{
    int64_t acc = 0;
    for (uint8_t i = 0; i < samples; ++i) {
        acc += HX711_ReadBlocking(dev);
    }
    return (int32_t)(acc / samples);
}

int HX711_StartReadAsync(hx711_t *dev, uint8_t samples, hx711_cb_t cb, void *user)
{
    if (dev->busy) return -1;
    dev->busy = 1;
    dev->cb = cb;
    dev->cb_user = user;
    dev->samples_target = samples ? samples : 1;
    dev->samples_done = 0;
    dev->accum = 0;
    dev->state = S_WAIT_READY;
    dev->start_tick_ms = HAL_GetTick();
    return 0;
}

int HX711_StartCalibrateAsync(hx711_t *dev,
                              int32_t knownWeight_mg,
                              uint8_t samples_for_tare,
                              uint8_t samples_for_known,
                              hx711_cb_t cb, void *user)
{
    if (dev->busy) return -1;
    dev->busy = 1;
    dev->cb = cb;
    dev->cb_user = user;
    dev->calibrate_known_weight = knownWeight_mg;
    dev->cal_samples_tare = samples_for_tare ? samples_for_tare : 10;
    dev->cal_samples_known = samples_for_known ? samples_for_known : 10;
    /* we reuse averaging mechanism; first gather tare samples, then ask user to add weight */
    dev->samples_target = dev->cal_samples_tare;
    dev->samples_done = 0;
    dev->accum = 0;
    dev->state = S_WAIT_READY;
    dev->start_tick_ms = HAL_GetTick();
    return 0;
}

/* Called when one sample reading completes (raw 24-bit signed) */
static void sample_complete(hx711_t *dev, int32_t raw)
{
    dev->accum += (int64_t)raw;
    dev->samples_done++;
    if (dev->samples_done < dev->samples_target) {
        /* more samples to take */
        dev->state = S_WAIT_READY;
        dev->start_tick_ms = HAL_GetTick();
        return;
    }

    /* Averaged raw */
    int32_t avg_raw = (int32_t)(dev->accum / dev->samples_done);

    /* If we were running a calibration (we used cal_samples_tare first), detect sequence */
    if (dev->cal_samples_tare && (dev->samples_target == dev->cal_samples_tare)) {
        /* we just finished tare measurement */
        dev->tare = avg_raw;
        /* now ask user to place known weight; we set samples_target to known samples and continue */
        dev->samples_target = dev->cal_samples_known;
        dev->samples_done = 0;
        dev->accum = 0;
        dev->cal_samples_tare = 0; /* indicate we've done tare stage */
        /* NOTE: caller should allow time to place weight; we will just wait for next poll loops */
        dev->state = S_WAIT_READY;
        dev->start_tick_ms = HAL_GetTick();
        return;
    }

    if (dev->cal_samples_tare == 0 && dev->samples_target == dev->cal_samples_known) {
        /* we finished known weight measurement: compute counts_per_mg */
        int32_t raw_known = avg_raw;
        int32_t diff = raw_known - dev->tare;
        if (diff <= 0) diff = 1;
        /* counts_per_mg = (diff * FP) / knownWeight_mg */
        dev->known_counts_per_mg = (int32_t)(((int64_t)diff * (int64_t)dev->FP) / (int64_t)dev->calibrate_known_weight);
        /* finish calibration and notify */
        dev->busy = 0;
        dev->state = S_IDLE;
        if (dev->cb) dev->cb(dev, HX_OP_CALIBRATE, 0, dev->cb_user);
        return;
    }

    /* Regular read finished (not calibration) */
    if (dev->samples_done == dev->samples_target) {
        dev->busy = 0;
        dev->state = S_IDLE;
        /* Calculate weight: (raw - tare) * FP / counts_per_mg => mg*FP/FP -> mg */
        int64_t diff = (int64_t)avg_raw - (int64_t)dev->tare;
        int32_t weight_mg = (int32_t)(((int64_t)diff * (int64_t)dev->FP) / (int64_t)dev->known_counts_per_mg);
        if (dev->cb) dev->cb(dev, HX_OP_READ, weight_mg, dev->cb_user);
    }
}

/* Main state machine - must be called frequently from main loop */
void HX711_Process(hx711_t *dev)
{
    if (!dev->busy) return;

    uint32_t nowu = now_us(dev->htim_us);

    switch (dev->state) {
    case S_WAIT_READY:
        /* wait DT low with millisecond timeout */
        if (dt_state(dev) == GPIO_PIN_RESET) {
            /* start reading bits */
            dev->bit_index = 0;
            dev->current_raw = 0;
            dev->state = S_BIT_RISE;
            /* set first rising immediately */
            dev->target_us = nowu; /* next action allowed now */
        } else {
            if ((HAL_GetTick() - dev->start_tick_ms) > WAIT_READY_TIMEOUT_MS) {
                /* timeout - abort */
                dev->busy = 0;
                dev->state = S_TIMEOUT;
                if (dev->cb) dev->cb(dev, HX_OP_READ, 0, dev->cb_user);
            }
        }
        break;

    case S_BIT_RISE:
        /* ensure we wait until target_us */
        if ((uint32_t)(nowu - dev->target_us) < 0x80000000u && nowu != dev->target_us && ((nowu - dev->target_us) & 0xFFFFFFFFu)) {
            /* not yet time */
            if ((uint32_t)(nowu - dev->target_us) < 1u) {
                /* micro schedule resolution - but keep simple: continue only when nowu >= target_us */
            }
        }
        /* simpler compare: proceed only when nowu >= target_us */
        if ((uint32_t)(nowu - dev->target_us) < 0x80000000u && nowu < dev->target_us) break;
        /* set SCK high to sample */
        sck_high(dev);
        dev->target_us = nowu + PULSE_HIGH_US;
        dev->state = S_BIT_FALL;
        break;

    case S_BIT_FALL:
        if ((int32_t)(nowu - dev->target_us) < 0) break; /* not yet */
        /* read bit while SCK was high */
        dev->current_raw = (dev->current_raw << 1) | ( (dt_state(dev) == GPIO_PIN_SET) ? 1u : 0u );
        /* pull SCK low and wait low phase */
        sck_low(dev);
        dev->bit_index++;
        if (dev->bit_index < 24) {
            /* schedule next rising after low period */
            dev->target_us = nowu + PULSE_LOW_US;
            dev->state = S_BIT_RISE;
        } else {
            /* finished 24 bits; do extra pulse(s) */
            dev->target_us = nowu + PULSE_LOW_US;
            dev->state = S_POST_PULSES;
            dev->bit_index = 0; /* reuse to count pulses done */
        }
        break;

    case S_POST_PULSES:
        if ((int32_t)(nowu - dev->target_us) < 0) break; /* wait */
        if (dev->bit_index < dev->extra_pulses) {
            /* pulse once */
            sck_high(dev);
            dev->target_us = nowu + PULSE_HIGH_US;
            dev->bit_index++; /* indicate pulse started; on next loop we'll set low */
            /* we need to set low after high time: reuse state to set low immediately after elapsed */
            /* set a special small substate by marking state S_BIT_FALL and rely on bit_index to know we're in pulse */
            dev->state = S_BIT_FALL;
        } else {
            /* convert 24-bit two's complement to signed 32-bit */
            uint32_t data = (uint32_t)dev->current_raw;
            if (data & 0x800000) data |= 0xFF000000u;
            sample_complete(dev, (int32_t)data);
        }
        break;

    case S_SAMPLE_DONE:
    case S_TIMEOUT:
    case S_IDLE:
    default:
        /* shouldn't be here for busy processes; clear busy to be safe */
        dev->busy = 0;
        dev->state = S_IDLE;
        break;
    }
}

/* Blocking convenience calibrate */
void HX711_CalibrateBlocking(hx711_t *dev, int32_t knownWeight_mg)
{
    /* measure tare */
    HAL_Delay(1000);
    dev->tare = HX711_GetAverageBlocking(dev, 10);
    HAL_Delay(500);
    HAL_Delay(3000); /* user place weight */
    int32_t raw_known = HX711_GetAverageBlocking(dev, 10);
    int32_t diff = raw_known - dev->tare;
    if (diff <= 0) diff = 1;
    dev->known_counts_per_mg = (int32_t)(((int64_t)diff * (int64_t)dev->FP) / (int64_t)knownWeight_mg);
}

/* Blocking weigh */
int32_t HX711_WeighBlocking(hx711_t *dev)
{
    int32_t raw = HX711_GetAverageBlocking(dev, 1);
    int64_t diff = (int64_t)raw - (int64_t)dev->tare;
    int32_t weight_mg = (int32_t)(((int64_t)diff * (int64_t)dev->FP) / (int64_t)dev->known_counts_per_mg);
    return weight_mg;
}
