/* persistent TIM handles for each motor instance */
static TIM_HandleTypeDef htim_dc[DC_MOTOR_UNITS] = {0};

/* helper: get timer input clock in Hz for STM32F1 timers */
static uint32_t DC_MOTOR_GetTimerClockHz(TIM_TypeDef *TIMx)
{
    /* TIM1 is on APB2; TIM2..TIM7 on APB1 (STM32F1 family typical mapping) */
    uint32_t pclk;
    uint32_t timclk;

    if (TIMx == TIM1) {
        pclk = HAL_RCC_GetPCLK2Freq();
        /* if APB2 prescaler != 1, timer runs at 2x PCLK */
        if ((RCC->CFGR & RCC_CFGR_PPRE2) != RCC_CFGR_PPRE2_DIV1) timclk = pclk * 2u;
        else timclk = pclk;
    } else {
        /* TIM2, TIM3, TIM4, TIM5, TIM6, TIM7 on APB1 for F1 series */
        pclk = HAL_RCC_GetPCLK1Freq();
        if ((RCC->CFGR & RCC_CFGR_PPRE1) != RCC_CFGR_PPRE1_DIV1) timclk = pclk * 2u;
        else timclk = pclk;
    }
    return timclk;
}

/* Replacement init that tries to use a 1 µs tick when possible */
void DC_MOTOR_Init(uint8_t au8_MOTOR_Instance)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    TIM_ClockConfigTypeDef sClockSourceConfig = {0};
    TIM_MasterConfigTypeDef sMasterConfig = {0};
    TIM_OC_InitTypeDef sConfigOC = {0};
    TIM_HandleTypeDef *htim = &htim_dc[au8_MOTOR_Instance];

    uint32_t tim_clk_hz;
    uint32_t desired_pwm_hz;
    uint8_t  req_res_bits;
    uint32_t max_arr = 0xFFFFu;

    /* -------- direction GPIO clocks (same logic as your original) -------- */
    if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO == GPIOA || DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO == GPIOA)
        __HAL_RCC_GPIOA_CLK_ENABLE();
    else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO == GPIOB || DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO == GPIOB)
        __HAL_RCC_GPIOB_CLK_ENABLE();
    else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO == GPIOC || DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO == GPIOC)
        __HAL_RCC_GPIOC_CLK_ENABLE();
    else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO == GPIOD || DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO == GPIOD)
        __HAL_RCC_GPIOD_CLK_ENABLE();
    else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO == GPIOE || DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO == GPIOE)
        __HAL_RCC_GPIOE_CLK_ENABLE();

    GPIO_InitStruct.Pin = DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, &GPIO_InitStruct);

    GPIO_InitStruct.Pin = DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, &GPIO_InitStruct);

    HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, GPIO_PIN_RESET);

    /* -------- compute timer parameters -------- */
    tim_clk_hz = DC_MOTOR_GetTimerClockHz(DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance);
    desired_pwm_hz = DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_FREQ_Hz;
    req_res_bits = DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_RES_BITS;

    /* Try to use 1 µs tick first */
    uint32_t psc_1us = tim_clk_hz / 1000000u;
    if (psc_1us > 0u) psc_1us -= 1u; /* PSC register = prescaler-1 */
    else psc_1us = 0u;

    /* ticks (at 1us) needed for requested period */
    uint64_t arr_req_64 = 1000000ull / (uint64_t)desired_pwm_hz; /* ARR+1 in ticks */
    if (arr_req_64 == 0) arr_req_64 = 1; /* protect divide by zero */

    uint32_t final_psc = (uint32_t)psc_1us;
    uint32_t final_arr = 0;

    if (arr_req_64 <= (uint64_t)(max_arr + 1u)) {
        /* fits into ARR with 1us tick */
        final_arr = (uint32_t)arr_req_64 - 1u;
    } else {
        /* Period too long for 1µs tick -> increase PSC so ARR fits */
        /* find smallest PSC >=0 that yields ARR <= max_arr */
        /* formula: ARR+1 = tim_clk / ((PSC+1) * pwm_hz)  => PSC+1 = tim_clk / ((ARR+1)*pwm_hz) */
        uint32_t needed_psc_plus1 = (uint32_t)(
            ( (uint64_t)tim_clk_hz + (uint64_t)desired_pwm_hz * (max_arr + 1u) - 1ull )
            / ((uint64_t)desired_pwm_hz * (max_arr + 1u))
        ); /* ceil division */
        if (needed_psc_plus1 == 0u) needed_psc_plus1 = 1u;
        if (needed_psc_plus1 > 0x10000u) {
            /* too large prescaler required to meet frequency with this timer; clamp */
            needed_psc_plus1 = 0x10000u; /* PSC will underflow to 0xFFFF below if -1'd; handle later */
        }
        final_psc = (needed_psc_plus1 > 0u) ? needed_psc_plus1 - 1u : 0u;

        /* compute ARR from chosen PSC */
        uint64_t arr_calc = (uint64_t)tim_clk_hz / ( (uint64_t)(final_psc + 1u) * (uint64_t)desired_pwm_hz );
        if (arr_calc == 0u) arr_calc = 1u;
        if (arr_calc > (uint64_t)(max_arr + 1u)) arr_calc = (uint64_t)(max_arr + 1u);
        final_arr = (uint32_t)arr_calc - 1u;
    }

    /* Safety clamps */
    if (final_arr > max_arr) final_arr = max_arr;
    if (final_psc > 0xFFFFu) final_psc = 0xFFFFu;

    /* Optional: determine effective tick in microseconds:
       tick_us = (PSC+1) * 1_000_000 / tim_clk_hz  (rounded) */
    uint32_t tick_us = (uint32_t)( ( (uint64_t)(final_psc + 1u) * 1000000ULL + tim_clk_hz/2 ) / tim_clk_hz );

    /* Optional: compute effective resolution in bits (0..floor(log2(final_arr+1))) */
    uint32_t effective_levels = final_arr + 1u;
    uint8_t eff_res_bits = 0;
    while (effective_levels > 1u) { effective_levels >>= 1; eff_res_bits++; }

    /* -------- configure the timer handle persistently -------- */
    htim->Instance = DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance;
    htim->Init.Prescaler = (uint16_t)final_psc;
    htim->Init.CounterMode = TIM_COUNTERMODE_UP;
    htim->Init.Period = final_arr;
    htim->Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim->Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;

    if (HAL_TIM_Base_Init(htim) != HAL_OK) { /* handle error: optional user code */ }

    sClockSourceConfig.ClockSource = TIM_CLOCKSOURCE_INTERNAL;
    if (HAL_TIM_ConfigClockSource(htim, &sClockSourceConfig) != HAL_OK) { /* handle error */ }

    if (HAL_TIM_PWM_Init(htim) != HAL_OK) { /* handle error */ }

    sMasterConfig.MasterOutputTrigger = TIM_TRGO_RESET;
    sMasterConfig.MasterSlaveMode = TIM_MASTERSLAVEMODE_DISABLE;
    if (HAL_TIMEx_MasterConfigSynchronization(htim, &sMasterConfig) != HAL_OK) { /* handle error */ }

    sConfigOC.OCMode = TIM_OCMODE_PWM1;
    sConfigOC.Pulse = 0; /* start stopped */
    sConfigOC.OCPolarity = TIM_OCPOLARITY_HIGH;
    sConfigOC.OCFastMode = TIM_OCFAST_DISABLE;

    if (HAL_TIM_PWM_ConfigChannel(htim, &sConfigOC, DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH) != HAL_OK) {
         /* handle error */
    }

    /* Ensure MSP post init sets pin AF for this TIM handle (CubeMX generated function or your own) */
    HAL_TIM_MspPostInit(htim);

    /* Start PWM */
    if (HAL_TIM_PWM_Start(htim, DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH) != HAL_OK) {
         /* handle error */
    }

    /* --- Debug / info (you can expose these via a debug print if you want) --- */
    /* final_psc, final_arr, tick_us (µs), eff_res_bits contain the final values */
    (void)tick_us;
    (void)eff_res_bits;
    /* e.g. use these to verify: TIMx->PSC == final_psc, TIMx->ARR == final_arr */
}
void DC_MOTOR_Start(uint8_t au8_MOTOR_Instance, uint8_t au8_DIR, uint16_t au16_SPEED)
{
	/* Write To The 2 Direction Control Pins */
	if(au8_DIR == DIR_CW)
	{
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, 1);
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, 0);
	}
	else if(au8_DIR == DIR_CCW)
	{
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, 0);
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, 1);
	}

	/* Write The Speed Value To The PWM CH DutyCycle Register */
	if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_1)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR1 = au16_SPEED;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_2)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR2 = au16_SPEED;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_3)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR3 = au16_SPEED;
	}
	else
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR4 = au16_SPEED;
	}
}

void DC_MOTOR_Set_Speed(uint8_t au8_MOTOR_Instance, uint16_t au16_SPEED)
{
	/* Write The Speed Value To The PWM CH DutyCycle Register */
	if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_1)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR1 = au16_SPEED;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_2)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR2 = au16_SPEED;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_3)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR3 = au16_SPEED;
	}
	else
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR4 = au16_SPEED;
	}
}

void DC_MOTOR_Set_Dir(uint8_t au8_MOTOR_Instance, uint8_t au8_DIR)
{
	/* Write To The 2 Direction Control Pins */
	if(au8_DIR == DIR_CW)
	{
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, 1);
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, 0);
	}
	else if(au8_DIR == DIR_CCW)
	{
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, 0);
		HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, 1);
	}
}

void DC_MOTOR_Stop(uint8_t au8_MOTOR_Instance)
{
	/* Write To The 2 Direction Control Pins */
	HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR1_PIN, 0);
	HAL_GPIO_WritePin(DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_GPIO, DC_MOTOR_CfgParam[au8_MOTOR_Instance].DIR2_PIN, 0);

	/* Write ZERO To The PWM Ch DutyCycle Register */
	if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_1)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR1 = 0;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_2)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR2 = 0;
	}
	else if(DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_TIM_CH == TIM_CHANNEL_3)
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR3 = 0;
	}
	else
	{
		DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_Instance->CCR4 = 0;
	}
}

uint32_t DC_MOTOR_Get_MaxFreq(uint8_t au8_MOTOR_Instance)
{
	uint32_t ARR_Value = 1;
    uint8_t i = 0;

	for(i=0; i<DC_MOTOR_CfgParam[au8_MOTOR_Instance].PWM_RES_BITS; i++)
	{
		ARR_Value *= 2;
	}
	return ((DC_MOTOR_CfgParam[au8_MOTOR_Instance].TIM_CLK_MHz*1000000)/ARR_Value);
}

void DC_MOTOR_Acelerar(uint8_t au8_MOTOR_Instance, uint16_t *au16_SPEED)
{
	switch(*au16_SPEED)
	{
	case 0:
		*au16_SPEED = LOW_SPEED;
		DC_MOTOR_Start(au8_MOTOR_Instance, DIR_CW, *au16_SPEED);
		return;
		break;
	case LOW_SPEED:
		*au16_SPEED = LOW_SPEED_PLUS;
		break;
	case LOW_SPEED_PLUS:
		*au16_SPEED = NORMAL_SPEED;
		break;
	case NORMAL_SPEED:
		*au16_SPEED = NORMAL_SPEED_PLUS;
		break;
	case NORMAL_SPEED_PLUS:
		*au16_SPEED = HIGH_SPEED;
		break;
	case HIGH_SPEED:
		*au16_SPEED = HIGH_SPEED_PLUS;
		break;
	default:
		break;
	}
	DC_MOTOR_Set_Speed(au8_MOTOR_Instance, *au16_SPEED);
};

void DC_MOTOR_Frenar(uint8_t au8_MOTOR_Instance, uint16_t *au16_SPEED)
{
	switch(*au16_SPEED)
	{
	default:
		break;
	case LOW_SPEED:
		*au16_SPEED = 0;
		DC_MOTOR_Stop(au8_MOTOR_Instance);
		return;
		break;
	case LOW_SPEED_PLUS:
		*au16_SPEED = LOW_SPEED;
		break;
	case NORMAL_SPEED:
		*au16_SPEED = LOW_SPEED_PLUS;
		break;
	case NORMAL_SPEED_PLUS:
		*au16_SPEED = NORMAL_SPEED;
		break;
	case HIGH_SPEED:
		*au16_SPEED = NORMAL_SPEED_PLUS;
		break;
	case HIGH_SPEED_PLUS:
		*au16_SPEED = HIGH_SPEED;
		break;
	}
	DC_MOTOR_Set_Speed(au8_MOTOR_Instance, *au16_SPEED);
};

void DC_MOTOR_Ajustar_velocidad(uint8_t au8_MOTOR_Instance, uint16_t *au16_SPEED, uint32_t *_actual, uint32_t *objetivo)
{
	if( objetivo - _actual <= 32000)
	{
		*au16_SPEED = LOW_SPEED;
		DC_MOTOR_Set_Speed(au8_MOTOR_Instance, *au16_SPEED);
	}
}

