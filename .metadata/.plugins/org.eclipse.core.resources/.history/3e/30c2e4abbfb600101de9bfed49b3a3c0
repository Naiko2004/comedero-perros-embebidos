#include "SERVO.h"
#include "SERVO_cfg.h"
#include "Util.h"
#include "SW_PWM.h"



void SERVO_Init(uint16_t au16_SERVO_Instance)
{
	SW_PWM_Init_Channel(
	        SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH, // TIM_CHANNEL_X
	        SERVO_CfgParam[au16_SERVO_Instance].TIM_Instance, // TIM2
	        SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH, // TIM_CHANNEL_X
	        SERVO_CfgParam[au16_SERVO_Instance].SERVO_GPIO, // GPIOx
	        SERVO_CfgParam[au16_SERVO_Instance].SERVO_PIN  // PINx
	    );
}

/* Moves A Specific Motor To A Specific Degree That Can Be Represented in Tenths of Degrees */
void SERVO_MoveTo(uint16_t au16_SERVO_Instance, uint16_t au16_Angle_Tenths)
{
    // 1. Obtener los parámetros del servo
    uint16_t P_Min = SERVO_CfgParam[au16_SERVO_Instance].MinPulse_us;
    uint16_t P_Max = SERVO_CfgParam[au16_SERVO_Instance].MaxPulse_us;

    // 2. Calcular la diferencia de pulso (Numerador)
    uint16_t Delta_P = P_Max - P_Min; // Ej: 2400 - 200 = 2200 us

    // 3. Constantes para el cálculo
    // La fórmula es: Pulso = ((Delta_P / 1800) * Angulo_Tenths) + P_Min

    // 4. Calcular el factor de punto fijo (Pendiente * Escala)
    // Pendiente_Fixed = (Delta_P / 1800) * 65536
    // Usamos uint32_t para evitar desbordamiento antes de la división
    uint32_t Slope_Fixed = ((uint32_t)Delta_P * FIXED_POINT_SCALE) / 1800;
    // 1800 es (180 grados * 10 décimas/grado)

    // 5. Aplicar la pendiente al ángulo
    // Multiplicación de punto fijo: (Slope_Fixed * Angulo_Tenths) / Escala
    uint32_t Pulse_Fractional = (Slope_Fixed * au16_Angle_Tenths) / FIXED_POINT_SCALE;

    // 6. Resultado final (en uS)
    uint16_t au16_Pulse_us = (uint16_t)(Pulse_Fractional + P_Min);

    // 7. Establecer el pulso (Usando la librería SW_PWM)
    SW_PWM_SetPulse(SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH, au16_Pulse_us);
    SW_PWM_Start(SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH);
}

/* Moves A Specific Motor With A Raw Pulse Width Value (Pulse in uS) */
void SERVO_RawMove(uint16_t au16_SERVO_Instance, uint16_t au16_Pulse_us)
{
    uint16_t min_us = SERVO_CfgParam[au16_SERVO_Instance].MinPulse_us;
    uint16_t max_us = SERVO_CfgParam[au16_SERVO_Instance].MaxPulse_us;

	if(au16_Pulse_us <= max_us && au16_Pulse_us >= min_us)
	{
		SW_PWM_SetPulse(SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH, au16_Pulse_us);
        SW_PWM_Start(SERVO_CfgParam[au16_SERVO_Instance].PWM_TIM_CH);
	}
}

/* Gets The Maximum Pulse Width Value For A Specific Motor (returns value in uS) */
uint16_t SERVO_Get_MaxPulse(uint16_t au16_SERVO_Instance)
{
	return SERVO_CfgParam[au16_SERVO_Instance].MaxPulse_us;
}


/* Gets The Minimum Pulse Width Value For A Specific Motor */
uint16_t SERVO_Get_MinPulse(uint16_t au16_SERVO_Instance)
{
	return SERVO_CfgParam[au16_SERVO_Instance].MinPulse_us;
}


/* Move A Motor From 0 deg to 180 And Back to 0 again */
void SERVO_Sweep(uint16_t au16_SERVO_Instance)
{
	uint8_t au8_Angle = 0;

	SERVO_MoveTo(au16_SERVO_Instance, 0);

	DELAY_MS(250);
	while(au8_Angle < 180)
	{
		SERVO_MoveTo(au16_SERVO_Instance, au8_Angle++);
		DELAY_MS(5);
	}
	DELAY_MS(250);
	while(au8_Angle > 0)
	{
		SERVO_MoveTo(au16_SERVO_Instance, au8_Angle--);
		DELAY_MS(5);
	}
}
