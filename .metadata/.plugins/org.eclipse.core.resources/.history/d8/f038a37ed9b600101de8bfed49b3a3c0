/* SW_PWM.h */
#ifndef SW_PWM_H_
#define SW_PWM_H_

#include "stm32f1xx_hal.h"

// Constantes del Servo (20 ms período)
#define SW_PWM_MAX_CHANNELS    4       // Timer 2 tiene 4 canales

// Mapeo de Canales
typedef enum
{
    SW_PWM_CH1 = 1, // Usar 1, 2, 3, 4 para indexar el array
    SW_PWM_CH2 = 2,
    SW_PWM_CH3 = 3,
    SW_PWM_CH4 = 4
} SW_PWM_Channel_t;

// Estructura de control y configuración
typedef struct
{
    uint8_t        Initialized;   // Flag de inicialización (0/1)
    uint8_t        Running;       // Flag de estado (0: Detenido, 1: Iniciado)
    TIM_TypeDef * TIM_Instance;
    uint32_t       Channel_ID;    // TIM_CHANNEL_1, TIM_CHANNEL_2, etc.
    GPIO_TypeDef * GPIO_Port;
    uint16_t       GPIO_Pin;
    uint32_t * TIM_CCRx;      // Puntero al registro CCRn
    uint16_t       Target_Pulse_us; // Ancho de pulso deseado (en us)
    uint16_t 	Target_Period_us; // Periodo del pulso deseado (en us)
} SW_PWM_Config_t;

extern SW_PWM_Config_t g_SW_PWM_Cfg[SW_PWM_MAX_CHANNELS];

// Prototypes
void SW_PWM_Init_Channel(SW_PWM_Channel_t sw_ch, TIM_TypeDef *tim_inst, uint32_t tim_ch_id, GPIO_TypeDef *port, uint16_t pin);
void SW_PWM_SetPulse(SW_PWM_Channel_t sw_ch, uint16_t pulse_us);
void SW_PWM_SetPeriod(SW_PWM_Channel_t sw_ch, uint16_t period_us);
void SW_PWM_Start(SW_PWM_Channel_t sw_ch);
void SW_PWM_Stop(SW_PWM_Channel_t sw_ch);

// Funciòn a llamar dentro de su TIM2_IRQHandler
void SW_PWM_Handle_OC_Interrupt(TIM_HandleTypeDef *htim, SW_PWM_Channel_t sw_ch);

#endif /* SW_PWM_H_ */
