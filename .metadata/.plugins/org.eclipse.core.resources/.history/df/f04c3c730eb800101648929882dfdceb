#ifndef HX711_H_
#define HX711_H_

#include "stdint.h"
#include "stm32f1xx_hal.h"

/*
 * Requirements:
 *  - Provide a TIM_HandleTypeDef configured at 1 MHz (1 µs tick).
 *  - Call HX711_Process() frequently (main loop or scheduler).
 *
 * Example:
 *   TIM2 configured to count up at 1 MHz:
 *     __HAL_TIM_SET_COUNTER(&htim2, 0);
 *     HAL_TIM_Base_Start(&htim2);
 */

typedef struct hx711_s {
    /* public part must already be initialized by caller */
    GPIO_TypeDef *dt_port;
    uint16_t dt_pin;
    GPIO_TypeDef *sck_port;
    uint16_t sck_pin;
    TIM_HandleTypeDef *htim_us;

    int32_t tare;
    int32_t known_counts_per_mg;
    int32_t FP;

    volatile uint8_t busy;

    /* private fields */
    state_e state;
    uint32_t start_tick_ms; /* HAL_GetTick based timeout start */

    /* bit reading */
    uint8_t bit_index;
    uint32_t current_raw; /* 24-bit accumulator */
    uint8_t extra_pulses; /* how many extra pulses (we keep 1 as original) */

    /* timing scheduling using TIM counter (1MHz) */
    uint32_t target_us; /* value of TIM counter when next action allowed */

    /* averaging */
    uint8_t samples_target;
    uint8_t samples_done;
    int64_t accum;

    /* callback */
    hx711_cb_t cb;
    void *cb_user;
    int32_t calibrate_known_weight; /* used during calibration */
    uint8_t cal_samples_tare;
    uint8_t cal_samples_known;
} hx711_t;

/* Callback: called when an async operation completes.
 *  `result_mg` for weighing / calibration final weight; for errors it will be 0.
 *  `op` is the operation that finished (see enum below).
 */
typedef enum {
    HX_OP_NONE = 0,
    HX_OP_READ,       // single read or average read finished
    HX_OP_CALIBRATE   // calibration finished
} hx711_operation_e;

typedef void (*hx711_cb_t)(hx711_t *dev, hx711_operation_e op, int32_t result_mg, void *user);

/* Create & init the handle */
struct hx711_s {
    GPIO_TypeDef *dt_port;
    uint16_t dt_pin;
    GPIO_TypeDef *sck_port;
    uint16_t sck_pin;

    TIM_HandleTypeDef *htim_us; /* timer at 1 MHz used for micro delays and scheduling */

    /* calibration / scale */
    int32_t tare;        /* raw offset */
    int32_t known_counts_per_mg; /* counts per mg (fixed-point scaling used) */

    /* fixed point scale (e.g. 1000 => milli-precision) */
    int32_t FP;

    /* internal state (do not touch directly) */
    uint8_t busy;
    /* more internal fields are private - implemented in .c */
};

/* Initialize a hx711 handle (fill the struct fields, then call this) */
void HX711_Construct(hx711_t *dev,
                     GPIO_TypeDef *dt_port, uint16_t dt_pin,
                     GPIO_TypeDef *sck_port, uint16_t sck_pin,
                     TIM_HandleTypeDef *htim_us,
                     int32_t fixed_point_scale);

/* LOW LEVEL blocking helpers (keeps behavior for compatibility) */
void HX711_InitPins(hx711_t *dev); /* sets SCK high then low like original */
int32_t HX711_ReadBlocking(hx711_t *dev); /* single reading (blocking) */
int32_t HX711_GetAverageBlocking(hx711_t *dev, uint8_t samples);

/* Asynchronous API */
/* Start an asynchronous averaged read:
 *  samples: number of measurements to average (1..255)
 *  cb: callback called when finished
 *  user: user pointer passed to callback
 *
 * Returns 0 if accepted, non-zero if device busy.
 */
int HX711_StartReadAsync(hx711_t *dev, uint8_t samples, hx711_cb_t cb, void *user);

/* Start an asynchronous calibration sequence:
 *  knownWeight_mg: known weight in mg used to compute counts per mg
 *  samples_for_tare / samples_for_known: averaging counts
 */
int HX711_StartCalibrateAsync(hx711_t *dev,
                              int32_t knownWeight_mg,
                              uint8_t samples_for_tare,
                              uint8_t samples_for_known,
                              hx711_cb_t cb, void *user);

/* Must be called frequently (main loop). Non-blocking. */
void HX711_Process(hx711_t *dev);

/* Convenience blocking calibrate (calls blocking reads internally) */
void HX711_CalibrateBlocking(hx711_t *dev, int32_t knownWeight_mg);

/* Get weight (blocking helper): returns weight in mg (according to FP and known_counts_per_mg) */
int32_t HX711_WeighBlocking(hx711_t *dev);

#endif /* HX711_H_ */
