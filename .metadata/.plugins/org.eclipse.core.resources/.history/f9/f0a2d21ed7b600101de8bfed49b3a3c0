/* SW_PWM.h */
#ifndef SW_PWM_H_
#define SW_PWM_H_

#include "stm32f1xx_hal.h"

// Definiciones de canales específicos que vamos a usar en el Timer 2
#define SW_PWM_TIMER_INSTANCE  TIM2
#define SW_PWM_CLK_FREQ        1000000 // 1 MHz (1 us tick)
#define SW_PWM_PERIOD_US       20000   // 20000 us = 20 ms

// Enum para mapear los canales del Timer 2
typedef enum
{
    SW_PWM_CH1 = TIM_CHANNEL_1,
    SW_PWM_CH2 = TIM_CHANNEL_2,
    SW_PWM_CH3 = TIM_CHANNEL_3,
    SW_PWM_CH4 = TIM_CHANNEL_4
} SW_PWM_Channel_t;

// Estructura de configuración por canal
typedef struct
{
    SW_PWM_Channel_t Channel;
    GPIO_TypeDef * GPIO_Port;
    uint16_t       GPIO_Pin;
    uint32_t * TIM_CCRx;       // Puntero al registro CCRn del canal
    uint32_t       CompareValue;   // Almacena el valor de comparación
} SW_PWM_Config_t;

// Variable externa para la configuración de los canales
extern SW_PWM_Config_t g_SW_PWM_Cfg[4]; // Soporte para 4 canales

// Prototypes
void SW_PWM_Init(SW_PWM_Channel_t Channel, GPIO_TypeDef * Port, uint16_t Pin);
void SW_PWM_SetPulse(SW_PWM_Channel_t Channel, uint16_t Pulse_us);
void SW_PWM_Timer_IRQHandler(TIM_HandleTypeDef *htim); // Declaración de la ISR

#endif /* SW_PWM_H_ */
