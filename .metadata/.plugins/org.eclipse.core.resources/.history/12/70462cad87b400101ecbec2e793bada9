/*---------------------[STATIC INTERNAL FUNCTIONS]-----------------------*/

static void utoa_dec(int32_t val, char *buf) {
    char tmp[12];
    int i = 0;
    if (val == 0) { buf[0] = '0'; buf[1] = 0; return; }
    uint8_t neg = 0;
    if (val < 0) { neg = 1; val = -val; }
    while (val) { tmp[i++] = '0' + (val % 10); val /= 10; }
    int p = 0;
    if (neg) buf[p++] = '-';
    while (i--) buf[p++] = tmp[i];
    buf[p] = 0;
}

/* --- colocar cerca del top de I2C_LCD.c --- */
#define I2C_SCL_GPIO_PORT  GPIOB
#define I2C_SDA_GPIO_PORT  GPIOB
#define I2C_SCL_PIN        GPIO_PIN_10   // PB10 para I2C2
#define I2C_SDA_PIN        GPIO_PIN_11   // PB11 para I2C2

static void I2C_BusRecover(void)
{
    GPIO_InitTypeDef gpio = {0};

    /* SDA input pull-up */
    gpio.Pin = I2C_SDA_PIN;
    gpio.Mode = GPIO_MODE_INPUT;
    gpio.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(I2C_SDA_GPIO_PORT, &gpio);

    /* SCL as open-drain output */
    gpio.Pin = I2C_SCL_PIN;
    gpio.Mode = GPIO_MODE_OUTPUT_OD;
    gpio.Pull = GPIO_PULLUP;
    gpio.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(I2C_SCL_GPIO_PORT, &gpio);

    /* Si SDA está baja, generar hasta 9 pulsos de SCL */
    for (int i = 0; (HAL_GPIO_ReadPin(I2C_SDA_GPIO_PORT, I2C_SDA_PIN) == GPIO_PIN_RESET) && (i < 9); ++i)
    {
        HAL_GPIO_WritePin(I2C_SCL_GPIO_PORT, I2C_SCL_PIN, GPIO_PIN_SET);
        DELAY_US(5);
        HAL_GPIO_WritePin(I2C_SCL_GPIO_PORT, I2C_SCL_PIN, GPIO_PIN_RESET);
        DELAY_US(5);
    }

    /* Generar STOP: SDA low -> SCL high -> SDA high */
    gpio.Pin = I2C_SDA_PIN;
    gpio.Mode = GPIO_MODE_OUTPUT_OD;
    gpio.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(I2C_SDA_GPIO_PORT, &gpio);

    HAL_GPIO_WritePin(I2C_SDA_GPIO_PORT, I2C_SDA_PIN, GPIO_PIN_RESET);
    DELAY_US(5);
    HAL_GPIO_WritePin(I2C_SCL_GPIO_PORT, I2C_SCL_PIN, GPIO_PIN_SET);
    DELAY_US(5);
    HAL_GPIO_WritePin(I2C_SDA_GPIO_PORT, I2C_SDA_PIN, GPIO_PIN_SET);
    DELAY_US(5);

    /* NOTA: no reinstanciamos I2C aquí; reconfigurar si hace falta desde MX o hacer un HAL_I2C_Init(hi2c) si el bus no responde */
}


