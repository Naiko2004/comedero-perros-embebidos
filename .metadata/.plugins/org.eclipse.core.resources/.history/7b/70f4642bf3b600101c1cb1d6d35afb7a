#ifndef SERVO_H_
#define SERVO_H_

#define HAL_TIM_MODULE_ENABLED

#include "stm32f1xx_hal.h"
#include "SW_PWM.h"

// El número de Servos
#define SERVO_NUM  1

// Constante de Punto Fijo: 2^16
#define FIXED_POINT_SCALE (1 << 16) // 65536

// Estructura de configuración (pulso en microsegundos, no en ms flotantes)
typedef struct
{
	GPIO_TypeDef * SERVO_GPIO;
	uint16_t       SERVO_PIN;
	TIM_TypeDef* TIM_Instance;
	uint32_t       PWM_TIM_CH;
	SW_PWM_Channel_t SW_PWM_CHANNEL;
	// CAMBIADO: Los pulsos ahora son en MICROSEGUNDOS (uint16_t)
	uint16_t       MinPulse_us;
	uint16_t       MaxPulse_us;
}SERVO_CfgType;


/*-----[ Prototypes For All Functions ]-----*/

void SERVO_Init(uint16_t au16_SERVO_Instance);
void SERVO_MoveTo(uint16_t au16_SERVO_Instance, uint16_t au16_Angle_Tenths);
void SERVO_RawMove(uint16_t au16_SERVO_Instance, uint16_t au16_Pulse);
uint16_t SERVO_Get_MaxPulse(uint16_t au16_SERVO_Instance);


#endif /* SERVO_H_ */
