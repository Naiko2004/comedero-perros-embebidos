/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  subestados_menus estado_menu = CONFIGURACION_IDLE;
  uint8_t dosis_objetivo = 0;
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  MX_RTC_Init();
  MX_I2C1_Init();
  MX_TIM3_Init();
  /* USER CODE BEGIN 2 */
  DC_MOTOR_Init(MOTOR_DOSIFICADOR);
  SERVO_Init(SERVO_PUERTA);
  SERVO_Timer3_Init_1usTicks();

  I2C_LCD_Init(I2C_LCD_1);
  Boton_init(&hbA, EXTI8_BOTON_A_GPIO_Port, EXTI8_BOTON_A_Pin);
  Boton_init(&hbB, EXTI9_BOTON_B_GPIO_Port, EXTI9_BOTON_B_Pin);
  Boton_init(&hbC, EXTI10_BOTON_C_GPIO_Port, EXTI10_BOTON_C_Pin);
  Boton_init(&hbD, EXTI11_BOTON_D_GPIO_Port, EXTI11_BOTON_D_Pin);

  HX711_Init();
  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
  I2C_LCD_WriteString(I2C_LCD_1, "AAA");

  HAL_RTC_GetTime(&hrtc, &displayTime, RTC_FORMAT_BIN);
  HAL_RTC_GetTime(&hrtc, &rtcTime, RTC_FORMAT_BIN);


  //SERVO_MoveTo(SERVO_PUERTA, 180);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  estados = ESTADO_IDLE;
  flag_debug = FLAG_INACTIVA;

  SERVO_MoveTo(SERVO_PUERTA, 170);

  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
  // uint16_t PULSE = SERVO_Get_MinPulse(SERVO_NUM); // 22528
  // PULSE = SERVO_Get_MaxPulse(SERVO_NUM); // 16384

  while (1)
  {

	  // Revisar y setear flags.
	HAL_RTC_GetTime(&hrtc, &rtcTime, RTC_FORMAT_BIN);
	if(displayTime.Seconds != rtcTime.Seconds)
	{
		flag_cambiar_hora = FLAG_ACTIVA;
	}

	if(hbA.FLAG_EVENTO == 1)
	{
		hbA.FLAG_EVENTO = 0;
		flag_boton_a_presionado = FLAG_ACTIVA;
	}

	if(hbB.FLAG_EVENTO == 1)
	{
		hbB.FLAG_EVENTO = 0;
		flag_boton_b_presionado = FLAG_ACTIVA;
	}

	if(hbC.FLAG_EVENTO == 1)
	{
		hbC.FLAG_EVENTO = 0;
		flag_boton_c_presionado = FLAG_ACTIVA;
	}

	if(hbD.FLAG_EVENTO == 1)
	{
		hbD.FLAG_EVENTO = 0;
		flag_boton_d_presionado = FLAG_ACTIVA;
	}

	if(flag_alarma_activada)
	{
		flag_iniciar_motor = FLAG_ACTIVA;
		flag_alarma_activada = FLAG_INACTIVA;
	}

	if(estados == ESTADO_DOSIFICANDO_ALIMENTO) // polling :(
	{
		if(HX711_weigh() == dosis_objetivo)
		{
			flag_detener_motor = FLAG_ACTIVA;
		}
	}

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	  // Maquina de estados.

	  switch(estados)
	  {
	  	  case ESTADO_IDLE:
	  		  if(flag_debug)
	  		  {
	  			  estados = ESTADO_DEBUG;
	  			  flag_debug = FLAG_INACTIVA;
	  		  }


	  		  if(flag_iniciar_motor)
	  		  {
	  			  estados = ESTADO_DOSIFICANDO_ALIMENTO;
	  			  velocidad_motor = LOW_SPEED;
	  			  DC_MOTOR_Start(MOTOR_DOSIFICADOR, DIR_CW, velocidad_motor);
	  			  SERVO_MoveTo(SERVO_PUERTA, 50);
	  			  I2C_LCD_Clear(I2C_LCD_1);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "Sirviendo");
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "alimento...");

	  			  flag_iniciar_motor = FLAG_INACTIVA;
	  		  }

	  		  if(flag_cambiar_hora)
	  		  {
	  			  displayTime = rtcTime;
	  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  			  flag_cambiar_hora = FLAG_INACTIVA;
	  		  }

	  		  if(flag_boton_a_presionado) // LISTO
	  		  {
	  			  estados = ESTADO_CONFIGURACION;
	  			  estado_menu = CONFIGURACION_IDLE;
	  			  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  I2C_LCD_Clear(I2C_LCD_1);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "A: Cambiar hora.");
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "B: Regular balanza.");
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "C: Probar motor.");
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "D: Siguiente");
	  		  }

	  		  if(flag_boton_b_presionado) // LISTO?
	  		  {
	  			  estados = ESTADO_AGREGAR_ALIMENTO;
	  			  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  estado_menu = AGREGAR_TIEMPO;
	  			  I2C_LCD_Clear(I2C_LCD_1);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "Hora objetivo:");
	  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +1m | B: -1m");
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "C: Escala | D: ->");
	  		  }

	  		  break;
	  	  case ESTADO_AGREGAR_ALIMENTO:
	  		  switch(estado_menu)
	  		  {
	  		  case AGREGAR_IDLE:
	  			  break;
	  		  case AGREGAR_TIEMPO:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				if(displayTime.Minutes < 59)
	  				{
	  					displayTime.Minutes++;
	  				}else if(displayTime.Hours < 23)
	  				{
	  					displayTime.Minutes = 0;
	  					displayTime.Hours++;
	  				}else{
	  					displayTime.Minutes = 0;
	  					displayTime.Hours = 0;
	  				}
	  				I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				if(displayTime.Minutes > 0)
	  				{
	  					displayTime.Minutes--;
	  				}else if(displayTime.Hours > 0)
	  				{
	  					displayTime.Minutes = 59;
	  					displayTime.Hours--;
	  				}else
	  				{
	  					displayTime.Minutes = 59;
	  					displayTime.Hours = 23;
	  				}
	  				I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado)
	  			  {
	  				  I2C_LCD_Clear(I2C_LCD_1);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "Hora objetivo:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +1h | B: -1h");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: Escala | D: ->");
		  			  estado_menu = AGREGAR_TIEMPO_HORAS;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado)
	  			  {
	  				  dosis_objetivo = 0;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Dosis objetivo:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "0 mg");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +22g | B: -22g");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: <- | D: ->");
	  				  estado_menu = AGREGAR_DOSIS;
	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case AGREGAR_TIEMPO_HORAS:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				if(displayTime.Hours < 23)
	  				{
	  					displayTime.Hours++;
	  				}else{
	  					displayTime.Hours = 0;
	  				}
	  				I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				if(displayTime.Hours > 0)
	  				{
	  					displayTime.Hours--;
	  				}else
	  				{
	  					displayTime.Hours = 23;
	  				}
	  				I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado)
	  			  {
	  				  I2C_LCD_Clear(I2C_LCD_1);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "Hora objetivo:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +1m | B: -1m");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: Escala | D: ->");
		  			  estado_menu = AGREGAR_TIEMPO;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado)
	  			  {
	  				  dosis_objetivo = 0;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Dosis objetivo:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "0 g");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +22g | B: -22g");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: <- | D: ->");
	  				  estado_menu = AGREGAR_DOSIS;
	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case AGREGAR_DOSIS:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				dosis_objetivo += 22;
	  				I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				I2C_LCD_WriteInt32(I2C_LCD_1, (int32_t)dosis_objetivo);
	  				I2C_LCD_WriteString(I2C_LCD_1, " g");
	  				flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				dosis_objetivo -= 22;
	  				I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				I2C_LCD_WriteInt32(I2C_LCD_1, (int32_t)dosis_objetivo);
	  				I2C_LCD_WriteString(I2C_LCD_1, " g");
	  				flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado)
	  			  {
		  			  estado_menu = AGREGAR_TIEMPO;
		  			  I2C_LCD_Clear(I2C_LCD_1);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "Hora objetivo:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +1m | B: -1m");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: Escala | D: ->");
	  				flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado)
	  			  {
	  				  estado_menu = AGREGAR_CONFIRMACION;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Hora de comida:");
	  				  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Dosis: ");
	  				  I2C_LCD_WriteInt32(I2C_LCD_1, dosis_objetivo);
	  				  I2C_LCD_WriteString(I2C_LCD_1, " g");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "C: <- | D: Ok");
	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case AGREGAR_CONFIRMACION:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado)
	  			  {
	  				  estado_menu = AGREGAR_DOSIS;
	  				  dosis_objetivo = 0;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Dosis objetivo:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "0 g");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "A: +22g | B: -22g");
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "C: <- | D: ->");
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado)
	  			  {
	  				  RTC_AlarmTypeDef comida = {0};
	  				  comida.AlarmTime = displayTime;
	  				  comida.Alarm = RTC_ALARM_A;
	  				  HAL_RTC_SetAlarm_IT(&hrtc, &comida, RTC_FORMAT_BIN);
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  estado_menu = AGREGAR_IDLE;
	  				  estados = ESTADO_IDLE;

	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  }
	  		  break;
	  	  case ESTADO_DOSIFICANDO_ALIMENTO:
	  		  if(flag_detener_motor)
	  		  {
	  			  displayTime.Hours = 0;
	  			  displayTime.Minutes = 0;
	  			  displayTime.Seconds = 0;
	  			  I2C_LCD_Clear(I2C_LCD_1);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  			  I2C_LCD_WriteString(I2C_LCD_1, "Alimento servido!");
	  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  			  SERVO_MoveTo(SERVO_PUERTA, 180);
	  			  estados = ESTADO_ALIMENTO_SERVIDO;
	  			  flag_detener_motor = FLAG_INACTIVA;
	  		  }
	  		  break;
	  	  case ESTADO_ALIMENTO_SERVIDO:
	  		  if(flag_cambiar_hora)
	  		  {
  				  if(displayTime.Seconds < 59)
  				  {
  					  displayTime.Seconds++;
  				  }else if(displayTime.Minutes < 59)
  				  {
  					  displayTime.Seconds = 0;
  					  displayTime.Minutes++;
  				  }else if(displayTime.Hours < 23)
  				  {
  					  displayTime.Seconds = 0;
  					  displayTime.Minutes = 0;
  					  displayTime.Hours++;
  				  }else{
  					  displayTime.Seconds = 0;
  					  displayTime.Minutes = 0;
  					  displayTime.Hours = 0;
  				  }
  				  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  			  flag_cambiar_hora = FLAG_INACTIVA;
	  		  }

	  		  break;
	  	  case ESTADO_CONFIGURACION:
	  		  switch(estado_menu)
