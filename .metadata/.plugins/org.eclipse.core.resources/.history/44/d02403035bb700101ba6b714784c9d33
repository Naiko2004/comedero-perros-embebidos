I2C_HandleTypeDef hi2c1;

RTC_HandleTypeDef hrtc;

TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;

/* USER CODE BEGIN PV */
Boton_HandlerTypeDef hbA;
Boton_HandlerTypeDef hbB;
Boton_HandlerTypeDef hbC;
Boton_HandlerTypeDef hbD;


estado estados = ESTADO_INICIANDO;
Motor_speeds velocidad_motor = NORMAL_SPEED;

RTC_TimeTypeDef displayTime;
RTC_TimeTypeDef rtcTime;

flag flag_debug = FLAG_INACTIVA;

flag flag_iniciar_motor = FLAG_INACTIVA;
flag flag_detener_motor = FLAG_INACTIVA;
flag flag_boton_a_presionado = FLAG_INACTIVA;
flag flag_boton_b_presionado = FLAG_INACTIVA;
flag flag_boton_c_presionado = FLAG_INACTIVA;
flag flag_boton_d_presionado = FLAG_INACTIVA;
flag flag_cambiar_hora = FLAG_INACTIVA;
flag flag_alarma_activada = FLAG_INACTIVA;


/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);
