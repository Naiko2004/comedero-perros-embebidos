	  				  estado_menu = CONFIGURACION_BALANZA;
	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado) // LISTO
	  			  {
	  				  velocidad_motor = 0;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Velocidad del motor:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Detenido");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: +vel | B: -vel");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "C: Volver");
	  				  estado_menu = CONFIGURACION_PROBAR_MOTOR;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado) // LISTO
	  			  {
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Probar Servo");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Probar barreras IR");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "C: Volver atras");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "D: Salir");
	  				  estado_menu = CONFIGURACION_IDLE2;
	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case CONFIGURACION_IDLE2:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Probar servo:");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Estado: ?");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Abrir | B: Cerrar");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "C: Volver");
	  				  estado_menu =	CONFIGURACION_SERVO;
	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				  estado_menu = CONFIGURACION_BARRERA_IR;
	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado) // LISTO
	  			  {
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Cambiar hora.");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Regular balanza.");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "C: Probar motor.");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "D: Siguiente");
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_d_presionado) // LISTO
	  			  {
	  				  displayTime = rtcTime;
		  			  I2C_LCD_Clear(I2C_LCD_1);
		  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
		  			  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
	  				  HAL_RTC_SetTime(&hrtc, &displayTime, RTC_FORMAT_BIN);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  estados = ESTADO_IDLE;
	  				  flag_boton_d_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case CONFIGURACION_CAMBIAR_HORA: // LISTO
	  			  if(flag_boton_a_presionado) // LISTO
	  			  {
	  				  /*if(displayTime.Seconds < 59)
	  				  {
	  					  displayTime.Seconds++;
	  				  }else*/ if(displayTime.Minutes < 59)
	  				  {
	  					  // displayTime.Seconds = 0;
	  					  displayTime.Minutes++;
	  				  }else if(displayTime.Hours < 23)
	  				  {
	  					  displayTime.Minutes = 0;
	  					  displayTime.Hours++;
	  				  }else{
	  					  displayTime.Minutes = 0;
	  					  displayTime.Hours = 0;
	  				  }
	  				  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado) // LISTO
	  			  {
	  				  if(displayTime.Minutes > 0)
	  				  {
	  					  displayTime.Minutes--;
	  				  }else if(displayTime.Hours > 0)
	  				  {
	  					  displayTime.Minutes = 59;
	  					  displayTime.Hours--;
	  				  }else
	  				  {
	  					  displayTime.Minutes = 59;
	  					  displayTime.Hours = 23;
	  				  }
	  				  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  flag_boton_b_presionado = FLAG_INACTIVA;

	  			  }
	  			  if(flag_boton_c_presionado) // LISTO
	  			  {
	  				  HAL_RTC_SetTime(&hrtc, &displayTime, RTC_FORMAT_BIN);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  estados = ESTADO_IDLE;
	  			  }
	  			  break;
	  		  case CONFIGURACION_PROBAR_MOTOR: // LISTO, INVESTIGAR PORQUE SE PARA EN RAPIDO
	  			  if(flag_boton_a_presionado) // LISTO
	  			  {
	  				  DC_MOTOR_Acelerar(MOTOR_DOSIFICADOR, &velocidad_motor);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "                  ");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  switch(velocidad_motor)
	  				  {
	  				  case 0:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Detenido");
	  					  break;
	  				  case LOW_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Lento");
	  					  break;
	  				  case LOW_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Lento+");
	  					  break;
	  				  case NORMAL_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Normal");
	  					  break;
	  				  case NORMAL_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Normal+");
	  					  break;
	  				  case HIGH_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Rapido");
	  					  break;
	  				  case HIGH_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Rapido+");
	  					  break;
	  				  default:
	  					  break;
	  				  }

	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }

	  			  if(flag_boton_b_presionado) // LISTO
	  			  {
	  				  DC_MOTOR_Frenar(MOTOR_DOSIFICADOR, &velocidad_motor);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "                  ");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  switch(velocidad_motor)
	  				  {
	  				  case 0:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Detenido");
	  					  break;
	  				  case LOW_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Lento");
	  					  break;
	  				  case LOW_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Lento+");
	  					  break;
	  				  case NORMAL_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Normal");
	  					  break;
	  				  case NORMAL_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Normal+");
	  					  break;
	  				  case HIGH_SPEED:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Rapido");
	  					  break;
	  				  case HIGH_SPEED_PLUS:
		  				  I2C_LCD_WriteString(I2C_LCD_1, "Rapido+");
	  					  break;
	  				  default:
	  					  break;
	  				  }

	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }

	  			  if(flag_boton_c_presionado) // LISTO
	  			  {
	  				  velocidad_motor = NORMAL_SPEED;
	  				  DC_MOTOR_Stop(MOTOR_DOSIFICADOR);
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  estados = ESTADO_IDLE;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;
	  		  case CONFIGURACION_BALANZA: // LISTO, PERO SE PUEDE AGREGAR UN BOTON D
	  			  if(flag_cambiar_hora) // ES HORRIBLE, PERO ES LO QUE HAY
	  			  {
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 6, 0);
	  				  I2C_LCD_WriteInt32(I2C_LCD_1, HX711_weigh() / 1000);
	  				  I2C_LCD_WriteString(I2C_LCD_1, " g    ");
	  				  displayTime = rtcTime;
	  				  flag_cambiar_hora = FLAG_INACTIVA;
	  			  }

	  			  if(flag_boton_a_presionado) // LISTO, PERO NO DEBERIA PISAR EL TARE PERMANENTEMENTE
	  			  {
	  				  tare += 1000;
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 6, 1);
	  				  I2C_LCD_WriteInt32(I2C_LCD_1, tare / 1000);
	  				  I2C_LCD_WriteString(I2C_LCD_1, " g    ");
	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }

	  			  if(flag_boton_b_presionado) // LISTO, IDEM BOTON A
	  			  {
	  				  tare -= 1000;
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 6, 1);
	  				  I2C_LCD_WriteInt32(I2C_LCD_1, tare / 1000);
	  				  I2C_LCD_WriteString(I2C_LCD_1, " g    ");
	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }

	  			  if(flag_boton_c_presionado) // LISTO, VER COMENTARIO
	  			  {
	  				  // A FUTURO EL COMMIT A MEMORIA
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  estados = ESTADO_IDLE;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }

	  			  break;
	  		  case CONFIGURACION_BARRERA_IR:
	  			  break;
	  		  case CONFIGURACION_SERVO:
	  			  if(flag_boton_a_presionado)
	  			  {
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Estado: Abierto");
	  				  SERVO_MoveTo(SERVO_PUERTA, 170);
	  				  flag_boton_a_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_b_presionado)
	  			  {
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 1);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Estado: Cerrado");
	  				  SERVO_MoveTo(SERVO_PUERTA, 50);
	  				  flag_boton_b_presionado = FLAG_INACTIVA;
	  			  }
	  			  if(flag_boton_c_presionado)
	  			  {
	  				  displayTime = rtcTime;
	  				  I2C_LCD_Clear(I2C_LCD_1);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "Hora actual:");
		  			  I2C_LCD_WriteTime(I2C_LCD_1, displayTime);
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 2);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "A: Configuracion");
	  				  I2C_LCD_SetCursor(I2C_LCD_1, 0, 3);
	  				  I2C_LCD_WriteString(I2C_LCD_1, "B: Agregar comida");
	  				  estado_menu = CONFIGURACION_IDLE;
	  				  estados = ESTADO_IDLE;
	  				  flag_boton_c_presionado = FLAG_INACTIVA;
	  			  }
	  			  break;

	  		  }
	  		  break;
	  	  case ESTADO_DEBUG:
	  		  int32_t peso = HX711_weigh();
	  		  if(flag_cambiar_hora)
	  		  {
	  			  I2C_LCD_Clear(I2C_LCD_1);
	  			  I2C_LCD_SetCursor(I2C_LCD_1, 0, 0);
	  			  I2C_LCD_WriteInt32(I2C_LCD_1, peso);
	  			  I2C_LCD_WriteString(I2C_LCD_1, " mg");

	  			  flag_cambiar_hora = FLAG_INACTIVA;
	  		  }
	  		  break;
	  };

  }
  /* USER CODE END 3 */
}

