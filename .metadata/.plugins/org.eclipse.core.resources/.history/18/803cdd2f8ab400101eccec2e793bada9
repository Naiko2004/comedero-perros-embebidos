#include "BOTONES.h"

void Boton_init(Boton_HandlerTypeDef *hb, GPIO_TypeDef* _DIR_GPIO,
		uint16_t _PIN_GPIO){
	hb->DIR_GPIO = _DIR_GPIO;
	hb->PIN_GPIO = _PIN_GPIO;
	hb->FLAG_EVENTO = 0;
	hb->__tiempo_presionado = 0;


};

static uint32_t Boton_GetTickDiff(uint32_t current_tick, uint32_t last_tick) {

}

void Boton_EXTI_Callback(Boton_HandlerTypeDef *hb){
	uint32_t tiempo_ahora = HAL_GetTick();
	uint32_t tiempo_pasado = 0;

    if (tiempo_ahora >=  hb->__tiempo_presionado) {
        tiempo_pasado = tiempo_ahora - hb->__tiempo_presionado;
    } else {
        // Manejo del desbordamiento: (2^32 - last_tick) + current_tick
    	tiempo_pasado = (0xFFFFFFFFU -  hb->__tiempo_presionado) + tiempo_ahora + 1;
    }
	if( (tiempo_ahora - hb->__tiempo_presionado) >=  DEBOUNCE_MS)
	{
		hb->FLAG_EVENTO = 1;
		hb->__tiempo_presionado = HAL_GetTick();
	}
};

